{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "video download: direct mp4 (fetch)",
      "program": "${workspaceFolder}/dist/index.js",
      "args": [
        "video",
        "download",
        "${input:mediaUrl}",
        "--mode",
        "http",
        "--output-dir",
        "${input:downloadOutputDir}",
        "--format",
        "json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "env": {
        "HTTP_PROXY": "${input:proxyUrl}"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "video download: direct m3u8 (fetch)",
      "program": "${workspaceFolder}/dist/index.js",
      "args": [
        "video",
        "download",
        "${input:mediaUrl}",
        "--mode",
        "http",
        "--output-dir",
        "${input:downloadOutputDir}",
        "--format",
        "json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "env": {
        "HTTP_PROXY": "${input:proxyUrl}"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "video download: page via browser (Playwright)",
      "program": "${workspaceFolder}/dist/index.js",
      "args": [
        "video",
        "download",
        "${input:pageUrl}",
        "--mode",
        "browser",
        "--output-dir",
        "${input:downloadOutputDir}",
        "--format",
        "json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "video sniff: http mode",
      "program": "${workspaceFolder}/dist/index.js",
      "args": [
        "video",
        "sniff",
        "${input:pageUrl}",
        "--mode",
        "http",
        "--format",
        "json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "env": {
        "HTTP_PROXY": "${input:proxyUrl}"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "video sniff: browser mode",
      "program": "${workspaceFolder}/dist/index.js",
      "args": [
        "video",
        "sniff",
        "${input:pageUrl}",
        "--mode",
        "browser",
        "--format",
        "json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "video compress",
      "program": "${workspaceFolder}/dist/index.js",
      "args": [
        "video",
        "compress",
        "${input:compressInputPath}",
        "--output-path",
        "${input:compressOutputPath}",
        "--format",
        "json"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "inputs": [
    {
      "id": "mediaUrl",
      "type": "promptString",
      "description": "Direct media URL (.mp4 or .m3u8)",
      "default": "https://example.com/video.mp4"
    },
    {
      "id": "pageUrl",
      "type": "promptString",
      "description": "Page URL to sniff/download",
      "default": "https://example.com/watch"
    },
    {
      "id": "downloadOutputDir",
      "type": "promptString",
      "description": "Download output directory",
      "default": "${workspaceFolder}\\downloads"
    },
    {
      "id": "compressInputPath",
      "type": "promptString",
      "description": "Local video path to compress",
      "default": "${workspaceFolder}\\downloads\\input.mp4"
    },
    {
      "id": "compressOutputPath",
      "type": "promptString",
      "description": "Compressed video output path",
      "default": "${workspaceFolder}\\downloads\\compressed.mp4"
    },
    {
      "id": "proxyUrl",
      "type": "promptString",
      "description": "HTTP proxy URL (leave empty for no proxy)",
      "default": ""
    }
  ]
}