    "table": "6.9.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/cli-progress": "3.11.6",
    "@types/node": "24.9.0",
    "@vitest/coverage-v8": "4.0.3",
    "tsup": "8.5.0",
